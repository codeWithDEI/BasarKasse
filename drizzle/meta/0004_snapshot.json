          "value": "\"payouts\".\"gross\" = \"payouts\".\"commission\" + \"payouts\".\"rounding\" + \"payouts\".\"net\" AND \"payouts\".\"net\" >= 0 AND \"payouts\".\"commission\" >= 0 AND \"payouts\".\"rounding\" BETWEEN 0 AND 9"
